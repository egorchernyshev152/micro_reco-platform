COMPOSE_PROJECT_NAME=micro-reco-platform

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

WEB_PORT=5173
CATALOG_SERVICE_PORT=8081
EVENT_SERVICE_PORT=8082
RECOMMENDER_SERVICE_PORT=8083

APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ASSETS_PUBLIC_URL=http://localhost:5173/api/catalog/assets

JWT_SECRET=change-me-local-dev-secret-change-me-local-dev-secret
TMDB_API_KEY=change-me
TMDB_PROXY_HOST=
TMDB_PROXY_PORT=0
TMDB_PROXY_USERNAME=
TMDB_PROXY_PASSWORD=

VITE_API_BASE_URL=/api/recommender
VITE_CATALOG_API_URL=/api/catalog

JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+UseContainerSupport
